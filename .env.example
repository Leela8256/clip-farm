# ── RocketRide engine connection (chat-editing mode) ──
# Auto-populated by the RocketRide VSCode extension when the engine is running.
ROCKETRIDE_URI=ws://localhost:5565/task/service
ROCKETRIDE_APIKEY=
# Anthropic key used by the llm_anthropic node inside chat_editor.pipe
# (substituted into the pipeline via ${ROCKETRIDE_ANTHROPIC_KEY}).
ROCKETRIDE_ANTHROPIC_KEY=sk-ant-...

# ── Redis (default works with docker-compose) ─────────
REDIS_URL=redis://localhost:6379/0

# ── Postgres (default works with docker-compose) ──────
DATABASE_URL=postgresql+psycopg://rocketride:rocketride@localhost:5432/rocketride_podcasts

# ── Audio settings ────────────────────────────────────
LOUDNESS_TARGET_LUFS=-16
TRUE_PEAK_DBTP=-1
CROSSFADE_MS=20
SILENCE_THRESHOLD_DB=-40
MIN_SILENCE_MS=800
FILLER_WORDS=um,uh,like,you know,basically,literally,actually,so yeah

# ── Whisper model (tiny/base/small/medium/large-v3) ───
# larger = more accurate, slower. 'medium' is the accuracy/speed sweet spot
# for podcast-length audio on CPU; drop to 'small' if transcription is too slow.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
# Set to 'cuda' if you have an NVIDIA GPU

# ── File storage ──────────────────────────────────────
UPLOAD_DIR=tmp/uploads
OUTPUT_DIR=tmp/outputs
ASSETS_INTRO=assets/intro/intro.mp3
ASSETS_OUTRO=assets/outro/outro.mp3

# ── Optional: Auphonic (replaces local mastering if set) ──
# AUPHONIC_API_KEY=

# ── CORS (frontend origin) ────────────────────────────
FRONTEND_URL=http://localhost:3000
