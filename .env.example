# Environment for the RocketRide *engine* process (the app has no backend of its own).
# Export these in the shell that starts the engine — see README.md.

# Any value; the browser sends the same key (NEXT_PUBLIC_ROCKETRIDE_APIKEY).
ROCKETRIDE_APIKEY=MYAPIKEY

# Anthropic key used by the llm_anthropic node in episode-analysis.pipe. The pipe
# contains the placeholder ${ROCKETRIDE_ANTHROPIC_KEY}; the engine substitutes it
# from its own environment, so the key never reaches the browser.
ROCKETRIDE_ANTHROPIC_KEY=sk-ant-...

# Enables signed download/stream URLs for files in the account store
# (the UI plays previews, exports and the source video through them).
RR_SIGNING_KEY=change-me-to-a-long-random-string

# Where the engine listens; the frontend reads the same address from
# NEXT_PUBLIC_ROCKETRIDE_URI (frontend/.env.local.example, docker-compose.yml).
ROCKETRIDE_URI=http://127.0.0.1:5567
