{
  "components": [
    {
      "id": "chat_source",
      "provider": "chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      }
    },
    {
      "id": "edl_memory",
      "provider": "memory_internal",
      "config": {
        "type": "memory_internal"
      }
    },
    {
      "id": "edl_tools",
      "provider": "tool_http_request",
      "config": {
        "type": "tool_http_request",
        "allowGET": true,
        "allowPOST": true,
        "allowPUT": false,
        "allowPATCH": false,
        "allowDELETE": false,
        "allowHEAD": false,
        "allowOPTIONS": false,
        "urlWhitelist": [
          {
            "whitelistPattern": "^http://localhost:8000/api/internal/tools/.*$"
          }
        ],
        "rateLimitPerSecond": 10,
        "rateLimitPerMinute": 100,
        "maxConcurrentRequests": 5
      }
    },
    {
      "id": "editor_llm",
      "provider": "llm_anthropic",
      "config": {
        "profile": "claude-sonnet-4-6",
        "claude-sonnet-4-6": {
          "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}"
        }
      }
    },
    {
      "id": "editor_agent",
      "provider": "agent_rocketride",
      "config": {
        "agent_description": "Podcast audio editor assistant. Edits a job's Edit Decision List (EDL) by calling HTTP tools that read the transcript and mutate cuts. Never touches audio directly — only proposes timestamped edits.",
        "instructions": [
          "You are a podcast audio editor assistant. Every request includes a 'Job ID' line in its context — pass that exact value as the job_id parameter on every tool call.",
          "You have access to a full transcript with word-level timestamps via HTTP tools, not directly in context.",
          "Always confirm before applying a cut larger than 60 seconds.",
          "When the user references a time ('around 12 minutes'), find the nearest natural pause within +/-30 seconds using the transcript-around tool.",
          "When the user describes content ('the part where I talked about X'), search the transcript text first and show the matching segment before cutting.",
          "Never cut mid-word. Always align cuts to word boundaries returned by the transcript tools.",
          "After every edit, summarise what changed and the new output runtime."
        ],
        "max_waves": 8
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_source"
        }
      ],
      "control": [
        {
          "classType": "llm",
          "from": "editor_llm"
        },
        {
          "classType": "memory",
          "from": "edl_memory"
        },
        {
          "classType": "tool",
          "from": "edl_tools"
        }
      ]
    },
    {
      "id": "response",
      "provider": "response_answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "editor_agent"
        }
      ]
    }
  ],
  "project_id": "73dc00e2-ca6b-451b-b16d-3f118acc4546",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}