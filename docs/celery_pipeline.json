{
  "name": "podcast_autopilot_pipeline",
  "version": "0.1.0",
  "description": "Architecture reference for the auto-pilot audio pipeline: transcribe -> auto-clean -> render -> master -> brand merge. This is executed by Celery tasks (backend/workers/tasks.py) calling these Python node classes directly — it is NOT a RocketRide .pipe file and is not executed by the RocketRide engine. For the real RocketRide-engine pipeline (chat-editing), see .rocketride/chat_editor.pipe.",
  "source": {
    "type": "webhook",
    "id": "source_upload",
    "outputs": { "audio_path": "text" }
  },
  "nodes": [
    {
      "id": "transcription",
      "type": "python",
      "module": "backend.nodes.transcription_node",
      "class": "TranscriptionNode",
      "inputs": { "audio_path": "source_upload.audio_path" },
      "outputs": { "transcript": "json" }
    },
    {
      "id": "auto_cleanup",
      "type": "python",
      "module": "backend.nodes.auto_cleanup_node",
      "class": "AutoCleanupNode",
      "inputs": {
        "audio_path": "source_upload.audio_path",
        "transcript": "transcription.transcript"
      },
      "outputs": { "edl": "json" }
    },
    {
      "id": "audio_dsp",
      "type": "python",
      "module": "backend.nodes.audio_dsp_node",
      "class": "AudioDSPNode",
      "inputs": { "edl": "auto_cleanup.edl" },
      "outputs": { "rendered_wav": "text" }
    },
    {
      "id": "mastering",
      "type": "python",
      "module": "backend.nodes.mastering_node",
      "class": "MasteringNode",
      "inputs": { "rendered_wav": "audio_dsp.rendered_wav" },
      "outputs": { "mastered_file": "text" }
    },
    {
      "id": "brand_merge",
      "type": "python",
      "module": "backend.nodes.brand_merge_node",
      "class": "BrandMergeNode",
      "inputs": { "mastered_file": "mastering.mastered_file" },
      "outputs": { "final_file": "text" }
    }
  ],
  "sink": { "from": "brand_merge.final_file" }
}
